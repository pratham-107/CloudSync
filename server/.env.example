NODE_ENV=development
PORT=5000

# CloudSync local stack: mongo on 27019, redis on 6381, minio on 9000 (see docker-compose.yml)
MONGODB_URI=mongodb://localhost:27019/cloudsync

JWT_SECRET=change-me-to-a-random-32-char-string
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# Storage driver options:
#   MinIO (free, local):          npm run setup:storage, endpoint http://localhost:9000, bucket cloudsync
#   Filebase (free, cardless):   endpoint https://s3.filebase.io, region auto, keys from console.
#                                Free tier has NO public buckets -> leave AWS_PUBLIC_BASE_URL empty and the
#                                API auto-mints short-lived presigned GET urls for previews/downloads.
#   Cloudflare R2 / AWS public:  set an endpoint (+ path style) or AWS_PUBLIC_BASE_URL for direct public URLs.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=auto
AWS_S3_BUCKET=cloudsync
AWS_S3_ENDPOINT=http://localhost:9000
AWS_CLOUDFRONT_DOMAIN=
AWS_PUBLIC_BASE_URL=

# Local dev: redis container (port 6381). In production Render injects the internal
# url (redis://red-xxx:6379) via render.yaml fromService; external urls use rediss://.
REDIS_URL=redis://localhost:6381
